datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Folder {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  color       String?
  documents   Document[]
  createdAt   DateTime   @default(now())
}

model Document {
  id               String         @id @default(uuid())
  supplierName     String
  supplierNif      String
  customerName     String?
  customerNif      String?
  docType          String
  docNumber        String
  docDate          String
  dueDate          String?
  atcud            String?
  iban             String?
  netAmount        Float
  taxAmount        Float
  totalAmount      Float
  isNonFiscalDoc   Boolean        @default(false)
  docNature        String?
  isIntracommunity Boolean        @default(false)
  category         String
  tags             String[]
  paymentStatus    String         @default("PENDING") // PENDING | PAID
  paymentDate      String?
  paymentMethod    String?
  folderId         String?
  folder           Folder?        @relation(fields: [folderId], references: [id])
  items            DocumentItem[]
  createdAt        DateTime       @default(now())
}

model DocumentItem {
  id          String   @id @default(uuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  code        String?
  description String
  quantity    Float    @default(1)
  unitPrice   Float
  discount    Float    @default(0)
  taxRate     Float    @default(23)
  total       Float
}

model BankTransaction {
  id          String   @id @default(uuid())
  date        String
  description String
  amount      Float
  matchedDocId String?
  isMatched   Boolean  @default(false)
  createdAt   DateTime @default(now())
}
